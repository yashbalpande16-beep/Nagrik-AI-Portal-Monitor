# Copy to .env for local development. Never commit real secrets.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Optional AI answers. If missing or quota/network fails, local civic guide is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DigiLocker requester integration is disabled until approved credentials are provided.
# Use only values supplied by the official approved DigiLocker integration process.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://127.0.0.1:5000/digilocker/callback
DIGILOCKER_AUTHORIZE_URL=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_SCOPE=
